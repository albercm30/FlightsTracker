# Copia este archivo como .env y rellena lo que quieras.
# Todo se puede cambiar después desde la pestaña Ajustes de la web.

# --- Fuente de precios ---
# Token gratuito: https://www.travelpayouts.com -> Profile/Herramientas -> API token
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# auto | travelpayouts | demo
PRICE_PROVIDER=auto
# Opcional: precio en vivo + histórico de Google Flights (https://serpapi.com, 250 búsquedas/mes gratis)
SERPAPI_KEY=

# --- Origen inicial (códigos IATA de ciudad separados por comas) ---
ORIGINS=MAD,BCN

# --- Avisos ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=

# --- Festivos de tu comunidad: canarias, madrid, cataluna, andalucia, valencia, pais_vasco, galicia, baleares
HOLIDAY_REGION=
TZ=Europe/Madrid

# --- Servidor ---
PORT=8000
DB_PATH=data/flights.db
# OBLIGATORIO si la publicas en internet: contraseña para entrar en la web
APP_PASSWORD=
# Detrás de un proxy HTTPS (Railway, Fly, Caddy, Cloudflare): pon 1 en ambas
TRUST_PROXY=
COOKIE_SECURE=
# Opcional: clave fija para las sesiones (si no, se genera y guarda en la base de datos)
SECRET_KEY=
